    removeEventListener: vi.fn(),
    dispatchEvent: vi.fn(),
  })),
});

describe('Motion Configuration', () => {
  it('provides correct spring configurations', () => {
    expect(motion.spring.snappy).toEqual({
      type: "spring",
      stiffness: 420,
      damping: 34
    });
    
    expect(motion.spring.soft).toEqual({
      type: "spring", 
      stiffness: 260,
      damping: 28
    });
  });

  it('respects reduced motion preferences', () => {
    // Test implementation of useReducedMotion hook
    const { result } = renderHook(() => useReducedMotion());
    expect(typeof result.current).toBe('boolean');
  });
});
