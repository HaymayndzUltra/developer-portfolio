### Chart Performance Testing
```typescript
// src/components/charts/AnimatedChart.test.tsx
import { render, waitFor } from '@testing-library/react';
import { AnimatedChart } from './AnimatedChart';

describe('AnimatedChart Performance', () => {
  const mockData = Array.from({ length: 90 }, (_, i) => ({
    date: `2024-01-${i + 1}`,
    value: Math.random() * 1000
  }));

  it('renders chart within performance budget', async () => {
    const startTime = performance.now();
    
    render(<AnimatedChart data={mockData} type="area" />);
    
    await waitFor(() => {
      const endTime = performance.now();
      const renderTime = endTime - startTime;
      
      // Chart should render within 50ms budget
      expect(renderTime).toBeLessThan(50);
    });
  });

  it('handles large datasets efficiently', () => {
    const largeDataset = Array.from({ length: 1000 }, (_, i) => ({
      date: `2024-01-${i + 1}`,
      value: Math.random() * 1000
    }));

    const { rerender } = render(<AnimatedChart data={largeDataset} type="area" />);
    
    // Measure re-render performance
    const startTime = performance.now();
    rerender(<AnimatedChart data={largeDataset} type="line" />);
    const endTime = performance.now();
    
    expect(endTime - startTime).toBeLessThan(80); // Filter update budget
  });
});
```

## E2E Testing with Playwright

### Modal Accessibility Testing
```typescript
// tests/modal-accessibility.spec.ts
import { test, expect } from '@playwright/test';

test.describe('Dashboard Modal Accessibility', () => {
  test('modal opens with proper focus management', async ({ page }) => {
    await page.goto('/');
    
    // Click first demo card
    const firstCard = page.locator('[data-testid="demo-card-saas"]');
    await firstCard.click();
    
    // Modal should be open and focused
    const modal = page.locator('[role="dialog"]');
    await expect(modal).toBeVisible();
    await expect(modal).toBeFocused();
    
    // Check ARIA attributes
    await expect(modal).toHaveAttribute('aria-modal', 'true');
    await expect(modal).toHaveAttribute('aria-labelledby');
  });

  test('focus trap works correctly in modal', async ({ page }) => {
    await page.goto('/');
    
    // Open modal
    await page.locator('[data-testid="demo-card-saas"]').click();
    
    // Tab through focusable elements
    await page.keyboard.press('Tab');
    await expect(page.locator('[data-testid="close-button"]')).toBeFocused();
    
    await page.keyboard.press('Tab');
    await expect(page.locator('[data-testid="date-range-selector"]')).toBeFocused();
    
    // Tab should cycle back to close button eventually
    for (let i = 0; i < 10; i++) {
      await page.keyboard.press('Tab');
    }
    await expect(page.locator('[data-testid="close-button"]')).toBeFocused();
  });

  test('escape key closes modal and returns focus', async ({ page }) => {
    await page.goto('/');
    
    const firstCard = page.locator('[data-testid="demo-card-saas"]');
    await firstCard.click();
    
    // Press Escape
    await page.keyboard.press('Escape');
    
    // Modal should be closed
    const modal = page.locator('[role="dialog"]');
    await expect(modal).not.toBeVisible();
    
    // Focus should return to the card
    await expect(firstCard).toBeFocused();
  });

  test('announces modal state to screen readers', async ({ page }) => {
    await page.goto('/');
    
    // Listen for aria-live announcements
    const liveRegion = page.locator('[aria-live="polite"]');
    
    await page.locator('[data-testid="demo-card-saas"]').click();
    
    // Should announce modal opening
    await expect(liveRegion).toContainText('saas dashboard opened');
  });
});
```

### Keyboard Navigation Testing
```typescript
// tests/keyboard-navigation.spec.ts
import { test, expect } from '@playwright/test';

test.describe('Keyboard Navigation', () => {
  test('full keyboard navigation flow', async ({ page }) => {
    await page.goto('/');
    
    // Tab through header navigation
    await page.keyboard.press('Tab'); // Skip to content link
    await page.keyboard.press('Tab'); // Logo
    await page.keyboard.press('Tab'); // Home nav
    await page.keyboard.press('Tab'); // About nav
    
    // Continue to demo cards
    for (let i = 0; i < 6; i++) {
      await page.keyboard.press('Tab');
      const card = page.locator(`[data-testid="demo-card-${i}"]`);
      await expect(card).toBeFocused();
      
      // Press Enter to open modal
      if (i === 0) {
        await page.keyboard.press('Enter');
        
        // Modal should open
        const modal = page.locator('[role="dialog"]');
        await expect(modal).toBeVisible();
        
        // Close with Escape
        await page.keyboard.press('Escape');
        await expect(modal).not.toBeVisible();
      }
    }
  });

  test('command palette keyboard shortcut', async ({ page }) => {
    await page.goto('/');
    
    // Open first dashboard
    await page.locator('[data-testid="demo-card-saas"]').click();
    
    // Use Cmd+K (or Ctrl+K on Windows/Linux)
    await page.keyboard.press('Meta+KeyK');
    
    const commandPalette = page.locator('[data-testid="command-palette"]');
    await expect(commandPalette).toBeVisible();
    
    // Type to filter commands
    await page.keyboard.type('export');
    
    const exportCommands = page.locator('[data-testid="command-item"]').filter({
      hasText: 'export'
    });
    await expect(exportCommands).toHaveCount(2); // CSV and PNG export
  });
});
```

### Performance Testing
```typescript
// tests/performance.spec.ts
import { test, expect } from '@playwright/test';

test.describe('Performance Metrics', () => {
  test('meets Lighthouse performance targets', async ({ page }) => {
    await page.goto('/');
    
    // Wait for page to be fully loaded
    await page.waitForLoadState('networkidle');
    
    // Run Lighthouse audit (requires lighthouse package)
    const lighthouse = await import('lighthouse');
    const lighthouseResult = await lighthouse.default(page.url(), {
      port: 9222,
      onlyCategories: ['performance', 'accessibility', 'best-practices', 'seo']
    });
    
    const scores = lighthouseResult.lhr.categories;
    
    expect(scores.performance.score).toBeGreaterThanOrEqual(0.9); // ≥ 90
    expect(scores.accessibility.score).toBeGreaterThanOrEqual(0.95); // ≥ 95
    expect(scores['best-practices'].score).toBeGreaterThanOrEqual(0.95); // ≥ 95
    expect(scores.seo.score).toBeGreaterThanOrEqual(0.9); // ≥ 90
  });

  test('dashboard filter updates meet performance budget', async ({ page }) => {
    await page.goto('/');
    
    // Open dashboard
    await page.locator('[data-testid="demo-card-saas"]').click();
    
    // Wait for dashboard to load
    await page.waitForSelector('[data-testid="chart-container"]');
    
    // Measure filter update performance
    const startTime = Date.now();
    
    await page.locator('[data-testid="date-range-7d"]').click();
    
    // Wait for charts to update
    await page.waitForFunction(() => {
      const charts = document.querySelectorAll('[data-testid="chart-container"]');
      return Array.from(charts).every(chart => 
        !chart.querySelector('[data-testid="chart-loading"]')
      );
    });
    
    const endTime = Date.now();
    const updateTime = endTime - startTime;
    
    // Should update within 80ms budget
    expect(updateTime).toBeLessThan(80);
  });

  test('no cumulative layout shift on modal open', async ({ page }) => {
    await page.goto('/');
    
    // Measure CLS before opening modal
    const clsBeforeModal = await page.evaluate(() => {
      return new Promise(resolve => {
        new PerformanceObserver(list => {
          const entries = list.getEntries();
          const clsScore = entries.reduce((sum, entry) => sum + entry.value, 0);
          resolve(clsScore);
        }).observe({ entryTypes: ['layout-shift'] });
        
        // Trigger some interactions to measure
        setTimeout(() => resolve(0), 1000);
      });
    });
    
    // Open modal
    await page.locator('[data-testid="demo-card-saas"]').click();
    
    // Measure CLS after modal
    const clsAfterModal = await page.evaluate(() => {
      return new Promise(resolve => {
        new PerformanceObserver(list => {
          const entries = list.getEntries();
          const clsScore = entries.reduce((sum, entry) => sum + entry.value, 0);
          resolve(clsScore);
        }).observe({ entryTypes: ['layout-shift'] });
        
        setTimeout(() => resolve(0), 1000);
      });
    });
    
    // CLS should remain within acceptable limits (≤ 0.03)
    expect(clsAfterModal).toBeLessThanOrEqual(0.03);
  });
});
```

