### Demo Card Component
```typescript
// components/DemoCard.tsx
import { motion } from 'framer-motion';

interface DemoCardProps {
  demo: typeof DEMO_CARDS[0];
  onOpen: (id: string) => void;
}

export function DemoCard({ demo, onOpen }: DemoCardProps) {
  return (
    <motion.div
      layoutId={`demo-${demo.id}`}
      className="bg-panel border border-[#162036] rounded-lg p-6 cursor-pointer group"
      whileHover={{ 
        y: -6,
        rotateX: 2,
        rotateY: 2,
        transition: { duration: 0.2 }
      }}
      whileTap={{ scale: 0.98 }}
      onClick={() => onOpen(demo.id)}
      tabIndex={0}
      role="button"
      aria-label={`Open ${demo.title} dashboard`}
      onKeyDown={(e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          onOpen(demo.id);
        }
      }}
    >
      <div className="mb-4">
        <h3 className="text-xl font-bold text-ink mb-2">{demo.title}</h3>
        <p className="text-accent text-sm">{demo.tagline}</p>
      </div>
      
      <p className="text-muted text-sm leading-relaxed">
        {demo.description}
      </p>
      
      {/* Hover indicator */}
      <div className="mt-4 opacity-0 group-hover:opacity-100 transition-opacity">
        <span className="text-accent text-xs">Click to explore →</span>
      </div>
    </motion.div>
  );
}
