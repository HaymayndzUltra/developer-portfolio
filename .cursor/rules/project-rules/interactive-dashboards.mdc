## Interaction Patterns

### Filter System
```typescript
// hooks/useFilters.ts
export function useFilters() {
  const [filters, setFilters] = useState<FilterState>({
    dateRange: '30d',
    quickFilters: [],
    search: '',
    customFilters: {}
  });

  const updateFilter = useCallback((key: string, value: any) => {
    setFilters(prev => ({
      ...prev,
      [key]: value
    }));
  }, []);

  const addQuickFilter = useCallback((filter: QuickFilter) => {
    setFilters(prev => ({
      ...prev,
      quickFilters: [...prev.quickFilters, filter]
    }));
  }, []);

  const removeQuickFilter = useCallback((filterId: string) => {
    setFilters(prev => ({
      ...prev,
      quickFilters: prev.quickFilters.filter(f => f.id !== filterId)
    }));
  }, []);

  const resetFilters = useCallback(() => {
    setFilters({
      dateRange: '30d',
      quickFilters: [],
      search: '',
      customFilters: {}
    });
  }, []);

  return {
    filters,
    updateFilter,
    addQuickFilter,
    removeQuickFilter,
    resetFilters
  };
}
```

### Command Palette
```typescript
// components/CommandPalette.tsx
export function CommandPalette() {
  const [isOpen, setIsOpen] = useState(false);

  useEffect(() => {
    const handleKeyboard = (e: KeyboardEvent) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        setIsOpen(true);
      }
    };

    document.addEventListener('keydown', handleKeyboard);
    return () => document.removeEventListener('keydown', handleKeyboard);
  }, []);

  const commands = [
    { id: 'filter-date', label: 'Filter by date range', action: () => {} },
    { id: 'export-csv', label: 'Export as CSV', action: () => {} },
    { id: 'export-png', label: 'Export chart as PNG', action: () => {} },
    { id: 'share-link', label: 'Share dashboard link', action: () => {} }
  ];

  return (
    <CommandDialog open={isOpen} onOpenChange={setIsOpen}>
      <CommandInput placeholder="Type a command or search..." />
      <CommandList>
        <CommandGroup heading="Actions">
          {commands.map(command => (
            <CommandItem key={command.id} onSelect={command.action}>
              {command.label}
            </CommandItem>
          ))}
        </CommandGroup>
      </CommandList>
    </CommandDialog>
  );
}
