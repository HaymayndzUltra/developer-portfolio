### Counter Animations
```typescript
// components/AnimatedCounter.tsx
interface AnimatedCounterProps {
  value: number;
  duration?: number;
  format?: (value: number) => string;
}

export function AnimatedCounter({ 
  value, 
  duration = 600, 
  format = (n) => n.toString() 
}: AnimatedCounterProps) {
  const prefersReducedMotion = useReducedMotion();
  const [displayValue, setDisplayValue] = useState(0);

  useEffect(() => {
    if (prefersReducedMotion) {
      setDisplayValue(value);
      return;
    }

    let startTime: number;
    let animationId: number;

    const animate = (timestamp: number) => {
      if (!startTime) startTime = timestamp;
      const progress = Math.min((timestamp - startTime) / duration, 1);
      
      // Easing function for smooth animation
      const easeOut = 1 - Math.pow(1 - progress, 3);
      const currentValue = Math.floor(easeOut * value);
      
      setDisplayValue(currentValue);

      if (progress < 1) {
        animationId = requestAnimationFrame(animate);
      }
    };

    animationId = requestAnimationFrame(animate);
    return () => cancelAnimationFrame(animationId);
  }, [value, duration, prefersReducedMotion]);

  return (
    <motion.span
      className="tabular-nums"
      initial={{ opacity: 0 }}
      animate={{ opacity: 1 }}
      transition={{ duration: 0.3 }}
    >
      {format(displayValue)}
    </motion.span>
  );
}
```

## Skills Section Animation

### Accordion Animations
```typescript
// components/Skills.tsx
export function Skills() {
  const [openSections, setOpenSections] = useState<string[]>([]);
  const prefersReducedMotion = useReducedMotion();

  const toggleSection = (sectionId: string) => {
    setOpenSections(prev => {
      const isOpen = prev.includes(sectionId);
      if (isOpen) {
        return prev.filter(id => id !== sectionId);
      } else {
        // Limit to 3 open sections
        const newSections = [...prev, sectionId];
        return newSections.slice(-3);
      }
    });
  };

  const containerVariants = {
    initial: {},
    animate: {
      transition: {
        staggerChildren: prefersReducedMotion ? 0 : motion.durations.staggerChild
      }
    }
  };

  const itemVariants = {
    initial: { opacity: 0, y: 20 },
    animate: { 
      opacity: 1, 
      y: 0,
      transition: { duration: prefersReducedMotion ? 0 : 0.4 }
    }
  };

  return (
    <motion.section
      variants={containerVariants}
      initial="initial"
      animate="animate"
      className="skills-section"
    >
      {skills.map(skill => (
        <motion.div
          key={skill.id}
          variants={itemVariants}
          className="skill-category"
        >
          <SkillCategory
            skill={skill}
            isOpen={openSections.includes(skill.id)}
            onToggle={() => toggleSection(skill.id)}
          />
        </motion.div>
      ))}
    </motion.section>
  );
}

// Individual skill category with height animation
export function SkillCategory({ skill, isOpen, onToggle }: SkillCategoryProps) {
  const prefersReducedMotion = useReducedMotion();

  return (
    <div className="skill-category">
      <button
        onClick={onToggle}
        className="skill-header"
        aria-expanded={isOpen}
      >
        <span>{skill.name}</span>
        <span className="skill-percentage">{skill.percentage}%</span>
        <motion.span
          animate={{ rotate: isOpen ? 180 : 0 }}
          transition={{ duration: prefersReducedMotion ? 0 : 0.2 }}
        >
          ↓
        </motion.span>
      </button>

      <AnimatePresence>
        {isOpen && (
          <motion.div
            initial={{ height: 0, opacity: 0 }}
            animate={{ 
              height: "auto", 
              opacity: 1,
              transition: {
                height: { duration: prefersReducedMotion ? 0 : 0.3 },
                opacity: { duration: prefersReducedMotion ? 0 : 0.2, delay: 0.1 }
              }
            }}
            exit={{ 
              height: 0, 
              opacity: 0,
              transition: {
                opacity: { duration: prefersReducedMotion ? 0 : 0.1 },
                height: { duration: prefersReducedMotion ? 0 : 0.2, delay: 0.1 }
              }
            }}
            className="skill-content"
          >
            <motion.div
              variants={containerVariants}
              initial="initial"
              animate="animate"
            >
              {skill.items.map((item, index) => (
                <motion.div
                  key={item}
                  variants={itemVariants}
                  className="skill-item"
                >
                  {item}
                </motion.div>
              ))}
            </motion.div>
          </motion.div>
        )}
      </AnimatePresence>
    </div>
  );
}
```

## Performance Optimization

### Animation Performance Rules
```typescript
// lib/animationUtils.ts
export const PERFORMANCE_RULES = {
  // Prefer transform and opacity for smooth animations
  preferredProperties: ['transform', 'opacity', 'filter'],
  
  // Avoid animating these properties
  avoidedProperties: ['width', 'height', 'top', 'left', 'margin', 'padding'],
  
  // Use will-change sparingly and clean up
  willChange: {
    set: (element: HTMLElement, properties: string[]) => {
      element.style.willChange = properties.join(', ');
    },
    remove: (element: HTMLElement) => {
      element.style.willChange = 'auto';
    }
  },
  
  // Timing targets
  targets: {
    chartRender: 50,      // First chart render ≤ 50ms
    filterUpdate: 80,     // Filter update ≤ 80ms
    modalTransition: 280, // Modal open/close ≤ 280ms
    microInteraction: 100 // Button hover/tap ≤ 100ms
  }
};

// Performance monitoring for animations
export function useAnimationPerformance(name: string) {
  const startTime = useRef<number>();
  
  const start = useCallback(() => {
    startTime.current = performance.now();
  }, []);
  
  const end = useCallback(() => {
    if (startTime.current) {
      const duration = performance.now() - startTime.current;
      console.log(`Animation "${name}" took ${duration.toFixed(2)}ms`);
      
      // Warn if animation exceeds targets
      const target = PERFORMANCE_RULES.targets[name as keyof typeof PERFORMANCE_RULES.targets];
      if (target && duration > target) {
        console.warn(`Animation "${name}" exceeded target of ${target}ms`);
      }
    }
  }, [name]);
  
  return { start, end };
}
