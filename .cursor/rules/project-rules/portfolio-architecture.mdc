          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.6 }}
        >
          Hi, I am <span className="text-accent">Ray</span>
        </motion.h1>
        
        <motion.p 
          className="text-lg text-ink/90 max-w-[680px] mx-auto mb-12 leading-relaxed"
